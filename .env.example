DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/cofepris
PORTAL_URL=https://tramiteselectronicos02.cofepris.gob.mx/BRSDM/default.aspx
TABLE_NAME=medicamentos
ATTEMPTS_TABLE_NAME=scraping_attempts
SCRAPER_RETRIES=3
SCRAPER_TIMEOUT_MS=30000
SCRAPER_BACKOFF_SECONDS=1.0
SCRAPER_STEALTH_ENABLED=true
SCRAPER_HEADLESS=true
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
SCRAPER_VIEWPORT_WIDTH=1280
SCRAPER_VIEWPORT_HEIGHT=720
SCRAPER_LOCALE=en-US
SCRAPER_TIMEZONE_ID=America/Mexico_City
SCRAPER_PROXY_SERVERS=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=
SCRAPER_PROXY_V2_ENABLED=false
SCRAPER_PROXY_CIRCUIT_FAILURE_THRESHOLD=3
SCRAPER_PROXY_CIRCUIT_COOLDOWN_SECONDS=600
SCRAPER_PROXY_HALF_OPEN_MAX_TRIALS=1
SCRAPER_PROXY_STICKY_TTL_SECONDS=900
SCRAPER_PROXY_HEALTH_DECAY_ON_SUCCESS=1
SCRAPER_PROXY_HEALTH_PENALTY_TIMEOUT=1
SCRAPER_PROXY_HEALTH_PENALTY_BLOCK=3
SCRAPER_PROXY_STRATEGY_FAILOPEN=true
LOAD_CHUNK_SIZE=10000
LOG_LEVEL=INFO
CRON_EXPRESSION=0 6 * * *
LOCK_PATH=/tmp/cofepris-brsdm.lock
